{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The `precommit` block of gitlab-precommit.yaml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "commit_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": "Repository paths the artifacts of the precommit jobs may write into the commit"
    },
    "hide_in_ui": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "description": "Patterns (.gitignore syntax) of the files hidden in merge request diffs"
    }
  }
}
